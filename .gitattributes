# Shell and Python scripts run on the TV (busybox sh / Linux Python).
# Force LF line endings regardless of the local Git core.autocrlf setting.
*.sh text eol=lf
*.py text eol=lf
*.command text eol=lf
scripts/*.sh text eol=lf
scripts/*.py text eol=lf
# Windows batch files must keep CRLF
*.bat text eol=crlf
